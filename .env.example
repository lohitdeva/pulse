# Copy to .env.local (gitignored) and fill in. Server-only values go into Supabase secrets, never into the app bundle.

# --- App (public, safe in the browser) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_VAPID_PUBLIC_KEY=

# --- Server only (supabase secrets set ...) ---
SUPABASE_SERVICE_ROLE_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:your-email@example.com
BRIDGE_SECRET_COLLEGE=
BRIDGE_SECRET_PERSONAL=
DIGEST_SECRET=
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
